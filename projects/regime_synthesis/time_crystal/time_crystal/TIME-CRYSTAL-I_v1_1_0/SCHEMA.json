{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIME-CRYSTAL-I Candidate Record",
  "type": "object",
  "required": [
    "id",
    "label",
    "domain",
    "sectors",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "quantum_many_body",
        "classical",
        "generic",
        "unknown"
      ]
    },
    "sectors": {
      "type": "object",
      "required": [
        "temporal",
        "rigidity",
        "collective",
        "spectral"
      ],
      "properties": {
        "temporal": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUPPORTED",
                "NOT_SUPPORTED",
                "PARTIAL",
                "NOT_TESTED",
                "N/A"
              ]
            }
          }
        },
        "rigidity": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUPPORTED",
                "NOT_SUPPORTED",
                "PARTIAL",
                "NOT_TESTED",
                "N/A"
              ]
            }
          }
        },
        "collective": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUPPORTED",
                "NOT_SUPPORTED",
                "PARTIAL",
                "NOT_TESTED",
                "N/A"
              ]
            }
          }
        },
        "spectral": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUPPORTED",
                "NOT_SUPPORTED",
                "PARTIAL",
                "NOT_TESTED",
                "N/A"
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}