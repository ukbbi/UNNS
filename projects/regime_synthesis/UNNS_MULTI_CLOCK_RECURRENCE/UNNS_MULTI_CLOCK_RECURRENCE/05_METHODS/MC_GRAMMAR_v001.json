  "domain": {
    "code": "D_2clk",
    "required": [
      "exactly two externally specified incommensurate source clocks",
      "genuine time-domain observable/state trajectory",
      "source clock ratio obtained from external source metadata only",
      "no response-derived clock",
      "no inverse-FFT or synthetic reconstruction as evidence"
    ],
    "empirically_supported_ratio_domain_v001": "golden-ratio branch only",
    "other_irrational_ratios": "OUTSIDE_EMPIRICALLY_QUALIFIED_RATIO_DOMAIN_v001",
    "recursive_Fibonacci_drives": "OUTSIDE_CHART_DOMAIN",
    "single_clock_integer_DTC": "OUTSIDE_CHART_DOMAIN / cross-chart control"
  },
  "source_coordinate_contract": {
    "requirement": "candidate adapter must map source time to cycles of one externally specified clock",
    "ratio_convention": "r = omega2/omega1 or equivalent source-defined frequency ratio used consistently by adapter",
    "clock_exchange_invariance": "must be preserved by the frozen robustness test"
  },
  "representation": {
    "parent_basis": {
      "depth": 1,
      "axis": [
        "1",
        "r"
      ],
      "mixed": [
        "abs(r-1)",
        "r+1"
      ]
    },
    "fractional_depths": [
      2,
      3,
      4
    ],
    "fractional_basis_at_depth_d": {
      "axis": [
        "1/d",
        "r/d"
      ],
      "mixed": [
        "abs(r-1)/d",
        "(r+1)/d"
      ]
    },
    "cv_folds": 5,
    "ridge_alpha": 1e-09,
    "jpr_near_phase_quantile": 0.01,
    "jpr_theiler_rule": "both source clocks must advance by at least one cycle",
    "jpr_state_scaling": "coordinatewise median/MAD; std fallback"
  },
  "P_src": {
    "metric": "JPR_parent_gain",
    "decision_use": "source-anchor gate",
    "null_model": "PHASE_LABEL_PERMUTE",
    "qualification_grid_max_samples": 5000,
    "qualification_grid_rule": "deterministic stride only; no interpolation",
    "jpr_pair_budget": 20000,
    "surrogates": 99,
    "monte_carlo_tail": "upper",
    "gate": {
      "operator": "<=",
      "p_upper": 0.1
    }
  },
  "J_frac": {
    "metric": "JPR_cover_advantage",
    "formula": "max_{d=2,3,4} JPR(d) - JPR(1)",
    "decision_use": "mandatory chart coordinate; non-gating",
    "threshold": null
  },
  "M_frac": {
    "metric": "FC_frac_mixed_gain",
    "formula": "nested_full_R2(d*) - nested_axis_R2(d*) at d* maximizing FC_frac_total_gain over d=2,3,4",
    "raw_gate": {
      "operator": ">=",
      "value": 0.12
    },
    "null_model": "FOURIER_PHASE",
    "qualification_grid_max_samples": 5000,
    "qualification_grid_rule": "deterministic stride only; no interpolation",
    "surrogates": 49,
    "monte_carlo_tail": "upper",
    "null_gate": {
      "operator": "<=",
      "p_upper": 0.1
    },
    "stability": {
      "requirement": "raw M_frac gate must remain satisfied under every frozen robustness transform",
      "variants": [
        "ORIGIN_SHIFT",
        "CLOCK_EXCHANGE",
        "AFFINE_STATE",
        "DOWNSAMPLE_5",
        "PREFIX_0.75",
        "NOISE_0.02SD"
      ]
    }
  },
  "robustness": {
    "origin_shift_cycles": 0.371,
    "affine_scale_base": 1.7,
    "affine_offset_base": 0.31,
    "downsample_factor": 5,
    "prefix_fraction": 0.75,
    "noise_sigma_fraction": 0.02,
    "clock_exchange": true
  },
  "supporting_nondecision_outputs": [
    "JPR_parent_gain",
    "JPR_cover_advantage",
    "FC_parent_full_r2",
    "FC_frac_total_gain",
    "vector-depth chart when legitimately applicable",
    "frequency-lattice chart when legitimately applicable"
  ],
  "explicitly_excluded_from_decision": [
