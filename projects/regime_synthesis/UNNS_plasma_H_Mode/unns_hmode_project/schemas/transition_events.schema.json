{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UNNS plasma transition event",
  "type": "object",
  "required": [
    "device",
    "shot_id",
    "event_time",
    "event_type"
  ],
  "properties": {
    "device": {
      "type": "string"
    },
    "shot_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "event_time": {
      "type": "number"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "LH",
        "HL",
        "DITHERING_START",
        "DITHERING_END",
        "ELM",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}