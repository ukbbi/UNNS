digraph G {
 rankdir=TB; nodesep=0.25; ranksep=0.35;
 node [shape=box, style="rounded,filled", fillcolor="#f4f8fb", color="#0072B2", fontname="Helvetica", fontsize=9, margin="0.12,0.06"];
 edge [color="#555555", arrowsize=0.6];
 B1B2 [label="cells, centre criterion\n(B1, B2)"];
 E1 [label="Thm: circuit-partition\ncriterion (G10-E1)"];
 LOW [label="rank >= 3 for any collision\n(B-LOW)"];
 F1 [label="full support, 1 in C\n(G10-F1)"];
 Z [label="no singleton circuits\n(G9-Z, G11-L5c)"];
 desc [label="descent to minimal sub-box\n(shortening, G9-T5)"];
 A1 [label="affine reduction\n(G10-A1)"];
 R [label="rigidity (G10-R)"];
 L5v [label="vector-space partition\n(G11-L5)"];
 L5b [label="counting identity, Parseval\n(G11-L5, G11-L5b)"];
 thr [label="threshold lemma\n(p>=9, 3<=m<=p/2)"];
 L6 [label="n2 >= p-1 for p>=9\n(G11-L6)"];
 small [label="finite enumeration p<=8\n(simplex normal form)", style="rounded,filled,dashed", fillcolor="#fff7ee", color="#D55E00"];
 W2 [label="W2 for all minimal boxes\n(G11-T3)"];
 L5l [label="local rank-3 extraction\n(G10-L5, B-COMMON)"];
 T4 [label="Thm: r_min = 3 for every\nnon-embedded box (G11-T4)", fillcolor="#e8f1f8"];
 B1B2->E1; B1B2->LOW; E1->F1; F1->Z; F1->R; F1->A1; R->L5v; L5v->L5b; Z->thr; L5b->L6; thr->L6;
 A1->small; L6->W2; small->W2; E1->desc; LOW->L5l; E1->L5l; W2->T4; L5l->T4; desc->T4;
}
