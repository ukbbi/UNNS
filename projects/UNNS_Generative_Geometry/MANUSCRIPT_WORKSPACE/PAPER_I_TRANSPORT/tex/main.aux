\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Three-dimensional non-containment (\cref  {thm:C1}; $\Lambda =2E_3\subset \Lambda '=2\mathbb  Z^3$, $Q=(2,4,2)$; \emph  {exact computation}). (a)~The $2$-cell $c=\Pi ((0,2,2);(0,2,-2),(2,-2,0))$ of $K_{\mathrm  {abs}}(2E_3,Q)$ in the box $[0,2]\times [0,4]\times [0,2]$ with its four corners $(0,2,2)$, $(0,4,0)$, $(2,0,2)$, $(2,2,0)$. (b)~The chart $c=u+sg+th$, $(s,t)\in [0,1]^2$, in the plane $x_1+x_2+x_3=4$: the part $T_0$ of $c$ inside the cube $[0,2]^3$ (light orange) is not covered by any cell of $K_{\mathrm  {abs}}(2\mathbb  Z^3,Q)$, whereas the part $T_1$ (outside that cube) is. The star is the witness $p=(\frac  23,\frac  53,\frac  53)=u+\frac  16g+\frac  13h\in T_0$, in $c$ but in no cell of $K_{\mathrm  {abs}}(2\mathbb  Z^3,Q)$ (exact enumeration); hence $U(2E_3,Q)\not \subseteq U(2\mathbb  Z^3,Q)$.}}{26}{figure.9}\protected@file@percent }
\newlabel{fig:noncontain}{{9}{26}{Three-dimensional non-containment (\cref {thm:C1}; $\Lambda =2E_3\subset \Lambda '=2\Z ^3$, $Q=(2,4,2)$; \emph {exact computation}). (a)~The $2$-cell $c=\Pil ((0,2,2);(0,2,-2),(2,-2,0))$ of $\Kabs (2E_3,Q)$ in the box $[0,2]\times [0,4]\times [0,2]$ with its four corners $(0,2,2)$, $(0,4,0)$, $(2,0,2)$, $(2,2,0)$. (b)~The chart $c=u+sg+th$, $(s,t)\in [0,1]^2$, in the plane $x_1+x_2+x_3=4$: the part $T_0$ of $c$ inside the cube $[0,2]^3$ (light orange) is not covered by any cell of $\Kabs (2\Z ^3,Q)$, whereas the part $T_1$ (outside that cube) is. The star is the witness $p=(\frac 23,\frac 53,\frac 53)=u+\frac 16g+\frac 13h\in T_0$, in $c$ but in no cell of $\Kabs (2\Z ^3,Q)$ (exact enumeration); hence $U(2E_3,Q)\not \subseteq U(2\Z ^3,Q)$}{figure.9}{}}
\newlabel{fig:noncontain@cref}{{[figure][9][]9}{[1][25][]26}}
