\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Why the strict-slab correction matters (\cref  {thm:slab-ii}, \cref  {rem:E1}; $\Lambda =2\mathbb  Z^2\oplus 2\mathbb  Z\subset \Lambda '=\mathbb  Z^2\oplus 2\mathbb  Z$, $k=2$, $Q=(2,2,2)$; \emph  {exact computation}). The cell $c=[0,2]^2\times \{2\}$ lies at height $x_3=k$. (a)~$U(\Lambda ',Q)$ and $c$. (b)~The slice $x_3<k$ is the origin-excluded $U(\mathbb  Z^2,(2,2))$, which does not contain $(\frac  12,\frac  12)$. (c)~The slice $x_3=k$ is the origin-allowed full square $U^0$. The point $p=(\frac  12,\frac  12,2)$ lies in $U(\Lambda ',Q)$ (and all $121$ grid points of $c$ do), so $c\subseteq U(\Lambda ',Q)$ and the corrected criterion (strict height $x_3<k$; here $c\cap \{x_3<k\}=\emptyset $) accepts $c$. The closed-height form of the first release would require $\mathrm  {proj}_{12}(c)\subseteq U(\mathbb  Z^2,(2,2))$, which fails at $(\frac  12,\frac  12)$, and would wrongly reject $c$.}}{30}{figure.12}\protected@file@percent }
\newlabel{fig:strict}{{12}{30}{Why the strict-slab correction matters (\cref {thm:slab-ii}, \cref {rem:E1}; $\Lambda =2\Z ^2\oplus 2\Z \subset \Lambda '=\Z ^2\oplus 2\Z $, $k=2$, $Q=(2,2,2)$; \emph {exact computation}). The cell $c=[0,2]^2\times \{2\}$ lies at height $x_3=k$. (a)~$U(\Lambda ',Q)$ and $c$. (b)~The slice $x_3<k$ is the origin-excluded $U(\Z ^2,(2,2))$, which does not contain $(\frac 12,\frac 12)$. (c)~The slice $x_3=k$ is the origin-allowed full square $U^0$. The point $p=(\frac 12,\frac 12,2)$ lies in $U(\Lambda ',Q)$ (and all $121$ grid points of $c$ do), so $c\subseteq U(\Lambda ',Q)$ and the corrected criterion (strict height $x_3<k$; here $c\cap \{x_3<k\}=\emptyset $) accepts $c$. The closed-height form of the first release would require $\mathrm {proj}_{12}(c)\subseteq U(\Z ^2,(2,2))$, which fails at $(\frac 12,\frac 12)$, and would wrongly reject $c$}{figure.12}{}}
\newlabel{fig:strict@cref}{{[figure][12][]12}{[1][30][]30}}
\newlabel{rem:E1}{{9.4}{30}{the erratum}{theorem.9.4}{}}
\newlabel{rem:E1@cref}{{[remark][4][9]9.4}{[1][30][]30}}
