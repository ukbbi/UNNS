\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Minkowski decomposition of a hard cell and the origin star (\cref  {prop:H1}; the cell $c$ of \cref  {thm:C1}, $\Lambda =2E_3$, $\Lambda '=2\mathbb  Z^3$; \emph  {exact computation}). (a)~$c=[a_1,b_1]+[a_2,b_2]$ with $a_1=(0,0,2)$, $b_1=(0,2,0)$, $a_2=(0,2,0)$, $b_2=(2,0,0)$ and $u=a_1+a_2=(0,2,2)$, drawn as the sum of two segments. (b)~The zonotope $Z^0=[0,2]\times [0,4]\times [0,2]$ tiled by $2\mathbb  Z^3$-cells: the tile $[0,2]^3$ has the origin as a vertex and is the star $\mathrm  {St}(0)$ (orange; it is not a cell of $K_{\mathrm  {abs}}(2\mathbb  Z^3,Q)$ because the origin is not in the fibre), the tile $[0,2]\times [2,4]\times [0,2]$ is a cell of the target. The only part of $c$ not covered by non-star tiles lies in $\mathrm  {St}(0)$; this is the region $T_0$ of \cref  {fig:noncontain}.}}{32}{figure.14}\protected@file@percent }
\newlabel{fig:hardcell}{{14}{32}{Minkowski decomposition of a hard cell and the origin star (\cref {prop:H1}; the cell $c$ of \cref {thm:C1}, $\Lambda =2E_3$, $\Lambda '=2\Z ^3$; \emph {exact computation}). (a)~$c=[a_1,b_1]+[a_2,b_2]$ with $a_1=(0,0,2)$, $b_1=(0,2,0)$, $a_2=(0,2,0)$, $b_2=(2,0,0)$ and $u=a_1+a_2=(0,2,2)$, drawn as the sum of two segments. (b)~The zonotope $Z^0=[0,2]\times [0,4]\times [0,2]$ tiled by $2\Z ^3$-cells: the tile $[0,2]^3$ has the origin as a vertex and is the star $\mathrm {St}(0)$ (orange; it is not a cell of $\Kabs (2\Z ^3,Q)$ because the origin is not in the fibre), the tile $[0,2]\times [2,4]\times [0,2]$ is a cell of the target. The only part of $c$ not covered by non-star tiles lies in $\mathrm {St}(0)$; this is the region $T_0$ of \cref {fig:noncontain}}{figure.14}{}}
\newlabel{fig:hardcell@cref}{{[figure][14][]14}{[1][32][]32}}
