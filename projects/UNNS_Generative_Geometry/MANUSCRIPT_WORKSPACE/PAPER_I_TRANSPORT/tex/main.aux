\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces The coupled family P4-F110 ($x_m=2\cdot 110^{4m}/9\to 110^{4m}/3$, $\Lambda _9=\{a-b+c\equiv 0\ (6)\}\subset E_3$, $Q_m=[0,2m]^3$; \emph  {exact computation} for the data, theorem-level for the regime in (c)). (a)~$n=2$ ($m=1$): $F(\Lambda _9,Q_1)$ (5 points) inside $F(E_3,Q_1)$ (13 points); $E_3$ is not hull-covered (\cref  {thm:hull}), the point $(0,1,\frac  32)$ is in $\operatorname  {conv}F(E_3)$ but in no cell of $K_{\mathrm  {abs}}(E_3,Q_1)$. (b)~The face $x_1=0$, where $E_3$ restricts to $E_2$ in the hollow box $(2,2)$ and the gap point appears as $(1,\frac  32)$. (c)~$n=4$ ($m=2$): $U(E_3,Q_2)=\{\DOTSB \sum@ \slimits@ x_i\ge 2\}$ by \cref  {thm:hull}, with $|F(E_3)|=62$ and $|F(\Lambda _9)|=20$. For $m=1$ containment $U(\Lambda _9)\subseteq U(E_3)$ nevertheless holds (\cref  {prop:holes}); for $m\ge 2$ it follows from \cref  {thm:hull} (see \cref  {thm:P4T2}), whose $n=4$ step rests on the certificate of \cref  {thm:hull}(3). No claim is drawn from the picture alone.}}{35}{figure.15}\protected@file@percent }
\newlabel{fig:f110}{{15}{35}{The coupled family P4-F110 ($x_m=2\cdot 110^{4m}/9\to 110^{4m}/3$, $\Lambda _9=\{a-b+c\equiv 0\ (6)\}\subset E_3$, $Q_m=[0,2m]^3$; \emph {exact computation} for the data, theorem-level for the regime in (c)). (a)~$n=2$ ($m=1$): $F(\Lambda _9,Q_1)$ (5 points) inside $F(E_3,Q_1)$ (13 points); $E_3$ is not hull-covered (\cref {thm:hull}), the point $(0,1,\frac 32)$ is in $\conv F(E_3)$ but in no cell of $\Kabs (E_3,Q_1)$. (b)~The face $x_1=0$, where $E_3$ restricts to $E_2$ in the hollow box $(2,2)$ and the gap point appears as $(1,\frac 32)$. (c)~$n=4$ ($m=2$): $U(E_3,Q_2)=\{\sum x_i\ge 2\}$ by \cref {thm:hull}, with $|F(E_3)|=62$ and $|F(\Lambda _9)|=20$. For $m=1$ containment $U(\Lambda _9)\subseteq U(E_3)$ nevertheless holds (\cref {prop:holes}); for $m\ge 2$ it follows from \cref {thm:hull} (see \cref {thm:P4T2}), whose $n=4$ step rests on the certificate of \cref {thm:hull}(3). No claim is drawn from the picture alone}{figure.15}{}}
