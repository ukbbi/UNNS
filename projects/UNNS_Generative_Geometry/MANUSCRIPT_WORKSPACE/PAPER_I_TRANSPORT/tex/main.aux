\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The body-centred target (\cref  {prop:C3}; FINITE-EXACT for $Q=(2,4,2)$ only). The cell $c$ of \cref  {fig:noncontain} and its chart $(s,t)$. (a)~The $13$ points of $F(\mathrm  {BCC},Q)$, $\mathrm  {BCC}=\{z_1\equiv z_2\equiv z_3\ (2)\}$. (b)~With the rectangular target $2\mathbb  Z^3$ ($f$-vector $(11,17,8,1)$) the uncovered region is the orange triangle $T_0$ of \cref  {fig:noncontain}. (c)~With the BCC target ($f$-vector $(13,33,17,1)$) the uncovered region is $T_0$ minus a teal segment, which lies in a BCC $2$-cell and is therefore covered; but the exact witness $p=(\frac  56,\frac  53,\frac  32)$ (chart coordinates $(\frac  14,\frac  5{12})$, star) lies in no cell of $K_{\mathrm  {abs}}(\mathrm  {BCC},Q)$. Shading is a floating-point raster (uncovered fractions $\approx 0.497$ and $\approx 0.493$ of the chart); the verdict at $p$ is exact. This is a finite-exact example, not a classification of non-split targets.}}{28}{figure.11}\protected@file@percent }
\newlabel{fig:bcc}{{11}{28}{The body-centred target (\cref {prop:C3}; FINITE-EXACT for $Q=(2,4,2)$ only). The cell $c$ of \cref {fig:noncontain} and its chart $(s,t)$. (a)~The $13$ points of $F(\mathrm {BCC},Q)$, $\mathrm {BCC}=\{z_1\equiv z_2\equiv z_3\ (2)\}$. (b)~With the rectangular target $2\Z ^3$ ($f$-vector $(11,17,8,1)$) the uncovered region is the orange triangle $T_0$ of \cref {fig:noncontain}. (c)~With the BCC target ($f$-vector $(13,33,17,1)$) the uncovered region is $T_0$ minus a teal segment, which lies in a BCC $2$-cell and is therefore covered; but the exact witness $p=(\frac 56,\frac 53,\frac 32)$ (chart coordinates $(\frac 14,\frac 5{12})$, star) lies in no cell of $\Kabs (\mathrm {BCC},Q)$. Shading is a floating-point raster (uncovered fractions $\approx 0.497$ and $\approx 0.493$ of the chart); the verdict at $p$ is exact. This is a finite-exact example, not a classification of non-split targets}{figure.11}{}}
\newlabel{fig:bcc@cref}{{[figure][11][]11}{[1][26][]28}}
