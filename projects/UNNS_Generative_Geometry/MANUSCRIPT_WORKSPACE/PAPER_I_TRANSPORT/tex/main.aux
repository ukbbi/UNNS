\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Why dimensions two and three differ (\cref  {thm:corner}(c)--(f), \cref  {rem:dim}; scaled coordinates; \emph  {theorem-level construction with exact coordinates}). (a)~$k=2$, scaled source $E_2\subset \mathbb  Z^2$: a cell reaching the corner square $O=[0,1)^2$ would need a nonzero vertex of $\ell _1$-size $\le 1$, i.e.\ $e_1$ or $e_2$, neither of which lies in $E_2$. (b)~$k=3$, scaled source $E_3\subset \mathbb  Z^3$: the points $(1,1,0),(1,0,1),(0,1,1)$ of $\ell _1$-size $2$ \emph  {do} lie in $E_3$; their triangle has its edges on faces $x_i=1$ of the unit cube, hence outside $O$, but its relative interior lies in $O$. The star is the centroid $(\frac  23,\frac  23,\frac  23)$. (c)~The same triangle in the section $x_1+x_2+x_3=2$. The triangle is not a cell by itself; in \cref  {fig:corner} it is part of the $2$-cell of $K_{\mathrm  {abs}}(E_3,Q)$ that realises the obstruction.}}{15}{figure.5}\protected@file@percent }
\newlabel{fig:dim}{{5}{15}{Why dimensions two and three differ (\cref {thm:corner}(c)--(f), \cref {rem:dim}; scaled coordinates; \emph {theorem-level construction with exact coordinates}). (a)~$k=2$, scaled source $E_2\subset \Z ^2$: a cell reaching the corner square $O=[0,1)^2$ would need a nonzero vertex of $\ell _1$-size $\le 1$, i.e.\ $e_1$ or $e_2$, neither of which lies in $E_2$. (b)~$k=3$, scaled source $E_3\subset \Z ^3$: the points $(1,1,0),(1,0,1),(0,1,1)$ of $\ell _1$-size $2$ \emph {do} lie in $E_3$; their triangle has its edges on faces $x_i=1$ of the unit cube, hence outside $O$, but its relative interior lies in $O$. The star is the centroid $(\frac 23,\frac 23,\frac 23)$. (c)~The same triangle in the section $x_1+x_2+x_3=2$. The triangle is not a cell by itself; in \cref {fig:corner} it is part of the $2$-cell of $\Kabs (E_3,Q)$ that realises the obstruction}{figure.5}{}}
\newlabel{fig:dim@cref}{{[figure][5][]5}{[1][15][]15}}
\newlabel{rem:dim}{{5.3}{15}{why dimension two is special}{theorem.5.3}{}}
\newlabel{rem:dim@cref}{{[remark][3][5]5.3}{[1][15][]15}}
