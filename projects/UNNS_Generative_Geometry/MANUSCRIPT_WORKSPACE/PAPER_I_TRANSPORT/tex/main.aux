\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Diagonal dilation preserves failure (\cref  {thm:D1,cor:C2}; \emph  {exact computation}). The failing pair $(E_3\subset \mathbb  Z^3,Q=(1,2,1))$ with its witness $(\frac  13,\frac  56,\frac  56)$ (a) and two dilations: $D=\mathrm  {diag}(2,2,2)$ giving $(2E_3\subset 2\mathbb  Z^3,(2,4,2))$ with witness $(\frac  23,\frac  53,\frac  53)$ (b) --- the configuration of \cref  {fig:noncontain} --- and $D=\mathrm  {diag}(3,1,2)$ giving the box $(3,2,2)$ with witness $(1,\frac  56,\frac  53)$ (c). In each panel the transformed box, the cell and the transformed corner cube (dashed) are drawn; the target axis orders are $(1,1,1)$, $(2,2,2)$ and $(3,1,2)$, so in (a) every coordinate is free, in (b) none is, and in (c) only $x_2$ is. Failure was verified exactly in all three cases.}}{27}{figure.10}\protected@file@percent }
\newlabel{fig:dilation}{{10}{27}{Diagonal dilation preserves failure (\cref {thm:D1,cor:C2}; \emph {exact computation}). The failing pair $(E_3\subset \Z ^3,Q=(1,2,1))$ with its witness $(\frac 13,\frac 56,\frac 56)$ (a) and two dilations: $D=\mathrm {diag}(2,2,2)$ giving $(2E_3\subset 2\Z ^3,(2,4,2))$ with witness $(\frac 23,\frac 53,\frac 53)$ (b) --- the configuration of \cref {fig:noncontain} --- and $D=\mathrm {diag}(3,1,2)$ giving the box $(3,2,2)$ with witness $(1,\frac 56,\frac 53)$ (c). In each panel the transformed box, the cell and the transformed corner cube (dashed) are drawn; the target axis orders are $(1,1,1)$, $(2,2,2)$ and $(3,1,2)$, so in (a) every coordinate is free, in (b) none is, and in (c) only $x_2$ is. Failure was verified exactly in all three cases}{figure.10}{}}
\newlabel{fig:dilation@cref}{{[figure][10][]10}{[1][25][]27}}
