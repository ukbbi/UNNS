\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Equal fibres, incomparable lattices (\cref  {prop:fibre-vs-lattice}(b); \emph  {exact computation}): $x=484/3$ and $x'=484/7$, primes $(2,11)$, box $[0,1]^2$, window $[-2,5]^2$ of the infinite lattices. (a)~$\Lambda _3=\{a+b\ \text  {even}\}$; (b)~$\Lambda _7=\{a\equiv b\ (3)\}$; (c)~overlay, with $\Lambda _3\cap \Lambda _7=\Lambda _{21}$. The shaded unit square is the box and the point $(1,1)$ is the common fibre $F=F'$. The stars are the exact witnesses $(2,0)\in \Lambda _3\setminus \Lambda _7$ and $(3,0)\in \Lambda _7\setminus \Lambda _3$: the lattices are incomparable although the fibres coincide, so the spanning hypothesis in \cref  {prop:fibre-vs-lattice}(c) cannot be dropped.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:equalfibres}{{2}{8}{Equal fibres, incomparable lattices (\cref {prop:fibre-vs-lattice}(b); \emph {exact computation}): $x=484/3$ and $x'=484/7$, primes $(2,11)$, box $[0,1]^2$, window $[-2,5]^2$ of the infinite lattices. (a)~$\Lambda _3=\{a+b\ \text {even}\}$; (b)~$\Lambda _7=\{a\equiv b\ (3)\}$; (c)~overlay, with $\Lambda _3\cap \Lambda _7=\Lambda _{21}$. The shaded unit square is the box and the point $(1,1)$ is the common fibre $F=F'$. The stars are the exact witnesses $(2,0)\in \Lambda _3\setminus \Lambda _7$ and $(3,0)\in \Lambda _7\setminus \Lambda _3$: the lattices are incomparable although the fibres coincide, so the spanning hypothesis in \cref {prop:fibre-vs-lattice}(c) cannot be dropped}{figure.2}{}}
