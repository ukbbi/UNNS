\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The three-stage orbit $P^4/3\to 2P^4/3\to P^4$ for $P=110$, $k=3$, $Q=[0,2]^3$ (\cref  {thm:E21,cor:threestage,prop:specimen}; \emph  {exact computation}). The first step is the identity on $(\Lambda ,Q)=(E_3,Q)$; the second enlarges $E_3$ to $\mathbb  Z^3$ ($13\to 13\to 26$ occurrences). (a)~Fibres: the $13$ points of $F(E_3,Q)$ persist, $13$ new points of $F(\mathbb  Z^3,Q)$ appear. (b)~Cell counts of the abstract complexes $K_{\mathrm  {abs}}(E_3,Q)$, f-vector $(13,45,36,3)$, and $K_{\mathrm  {abs}}(\mathbb  Z^3,Q)$, f-vector $(26,51,33,7)$: all $13$ vertices persist (green) and no positive-dimensional cell does (red: lost; hatched teal: new). The abstract Betti numbers change from $(1,6,6,0)$ to $(1,0,0,0)$. Only abstract complexes are counted; the realised unions are compared in \cref  {sec:realised}.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:threestage}{{3}{12}{The three-stage orbit $P^4/3\to 2P^4/3\to P^4$ for $P=110$, $k=3$, $Q=[0,2]^3$ (\cref {thm:E21,cor:threestage,prop:specimen}; \emph {exact computation}). The first step is the identity on $(\Lambda ,Q)=(E_3,Q)$; the second enlarges $E_3$ to $\Z ^3$ ($13\to 13\to 26$ occurrences). (a)~Fibres: the $13$ points of $F(E_3,Q)$ persist, $13$ new points of $F(\Z ^3,Q)$ appear. (b)~Cell counts of the abstract complexes $\Kabs (E_3,Q)$, f-vector $(13,45,36,3)$, and $\Kabs (\Z ^3,Q)$, f-vector $(26,51,33,7)$: all $13$ vertices persist (green) and no positive-dimensional cell does (red: lost; hatched teal: new). The abstract Betti numbers change from $(1,6,6,0)$ to $(1,0,0,0)$. Only abstract complexes are counted; the realised unions are compared in \cref {sec:realised}}{figure.3}{}}
\newlabel{fig:threestage@cref}{{[figure][3][]3}{[1][11][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Planar family $21^{2h}/5\to 21^{2h}/4$ for $h=8$ (\cref  {thm:P2TF1}; \emph  {exact computation} of $K_{\mathrm  {abs}}$). (a)~The $73$ edges of $K_{\mathrm  {abs}}(\Lambda ,Q)$, $\Lambda =\{a\equiv b\ (4)\}$: the $15=E_{\mathrm  {kept}}(8)$ edges with generator $\pm (1,1)$ persist (green, thick) and the other $58$ are lost (red, dotted). (b)~The $125$ edges of $K_{\mathrm  {abs}}(\Lambda ',Q)$, $\Lambda '=\{a\equiv b\ (2)\}$, with the persisting edges again green. (c)~The Graver sets $\operatorname  {Gr}(\Lambda )$ and $\operatorname  {Gr}(\Lambda ')$ (each symmetric under $v\DOTSB \mapstochar \rightarrow -v$) in the window $[-4,4]^2$; they share only $\pm (1,1)$, which is why only $(1,1)$-edges can persist (\cref  {thm:cell-transport}). The panels show abstract complexes (edges only), not the realised unions.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:planar}{{4}{13}{Planar family $21^{2h}/5\to 21^{2h}/4$ for $h=8$ (\cref {thm:P2TF1}; \emph {exact computation} of $\Kabs $). (a)~The $73$ edges of $\Kabs (\Lambda ,Q)$, $\Lambda =\{a\equiv b\ (4)\}$: the $15=E_{\mathrm {kept}}(8)$ edges with generator $\pm (1,1)$ persist (green, thick) and the other $58$ are lost (red, dotted). (b)~The $125$ edges of $\Kabs (\Lambda ',Q)$, $\Lambda '=\{a\equiv b\ (2)\}$, with the persisting edges again green. (c)~The Graver sets $\Gr (\Lambda )$ and $\Gr (\Lambda ')$ (each symmetric under $v\mapsto -v$) in the window $[-4,4]^2$; they share only $\pm (1,1)$, which is why only $(1,1)$-edges can persist (\cref {thm:cell-transport}). The panels show abstract complexes (edges only), not the realised unions}{figure.4}{}}
\newlabel{fig:planar@cref}{{[figure][4][]4}{[1][13][]13}}
