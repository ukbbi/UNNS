\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Geometry of the planar proof (\cref  {thm:planar}, steps (1)--(7); \emph  {exact computation of one instance of the construction}). Hard cell $c=\Pi ((0,6);(2,-4),(4,-2))$ of the source lattice $\{x+2y\equiv 0,\ 2x+y\equiv 0\ (6)\}$, target $\Lambda '=2\mathbb  Z^2$ (so $k'=l'=2$), box $[0,6]^2$. (a)~Opposite axis corners $A=(0,6)$ and $B=(6,0)$ and the other two corners $D=(2,2)$, $E=(4,4)$; the dotted line $x/k'+y/l'=2$ (i.e.\ $x+y=4$) passes through $D$, the corners $A,B,E$ lie strictly above it, and the whole cell lies on or above it; the $2\times 2$ rectangles of the target tiling of $[0,x_0]\times [0,y_0]$ are dashed teal, and the corner square $[0,2]^2$ at the origin (orange, hatched) is the region the cell never enters. (b)~The same cell in the ratio coordinates $(x/k',y/l')$, where all four corners satisfy the inequality; by convexity so does every point of $c$. All $441$ grid points of $c$ were tested exactly against $U(2\mathbb  Z^2,Q)$. The cell is an actual hard cell, not a schematic; the picture illustrates the general argument by this instance.}}{23}{figure.8}\protected@file@percent }
\newlabel{fig:planarproof}{{8}{23}{Geometry of the planar proof (\cref {thm:planar}, steps (1)--(7); \emph {exact computation of one instance of the construction}). Hard cell $c=\Pil ((0,6);(2,-4),(4,-2))$ of the source lattice $\{x+2y\equiv 0,\ 2x+y\equiv 0\ (6)\}$, target $\Lambda '=2\Z ^2$ (so $k'=l'=2$), box $[0,6]^2$. (a)~Opposite axis corners $A=(0,6)$ and $B=(6,0)$ and the other two corners $D=(2,2)$, $E=(4,4)$; the dotted line $x/k'+y/l'=2$ (i.e.\ $x+y=4$) passes through $D$, the corners $A,B,E$ lie strictly above it, and the whole cell lies on or above it; the $2\times 2$ rectangles of the target tiling of $[0,x_0]\times [0,y_0]$ are dashed teal, and the corner square $[0,2]^2$ at the origin (orange, hatched) is the region the cell never enters. (b)~The same cell in the ratio coordinates $(x/k',y/l')$, where all four corners satisfy the inequality; by convexity so does every point of $c$. All $441$ grid points of $c$ were tested exactly against $U(2\Z ^2,Q)$. The cell is an actual hard cell, not a schematic; the picture illustrates the general argument by this instance}{figure.8}{}}
\newlabel{fig:planarproof@cref}{{[figure][8][]8}{[1][22][]23}}
