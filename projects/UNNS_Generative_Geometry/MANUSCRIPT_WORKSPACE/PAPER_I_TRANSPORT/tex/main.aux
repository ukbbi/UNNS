\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Geometry of a split target (\cref  {thm:slab-i}; $\Lambda '=E_2\oplus 2\mathbb  Ze_3$, $Q=(2,2,4)$, $k=2$, $J=2$; planar complexes \emph  {exact}, vertical stacking \emph  {schematic}). (a)~The union $U(\Lambda ',Q)$: below height $k$ the slice is the origin-excluded planar union $U=U(E_2,(2,2))$ (blue; one-dimensional here, $5$ edges and no square), from height $k$ upward it is the origin-allowed union $U^0$ (orange; the filled square $[0,2]^2$ and $8$ edges). (b)~The two planar slices. A source cell is contained iff its part below height $k$ projects into $U$. The figure shows a realised union, not an abstract complex.}}{31}{figure.13}\protected@file@percent }
\newlabel{fig:slab}{{13}{31}{Geometry of a split target (\cref {thm:slab-i}; $\Lambda '=E_2\oplus 2\Z e_3$, $Q=(2,2,4)$, $k=2$, $J=2$; planar complexes \emph {exact}, vertical stacking \emph {schematic}). (a)~The union $U(\Lambda ',Q)$: below height $k$ the slice is the origin-excluded planar union $U=U(E_2,(2,2))$ (blue; one-dimensional here, $5$ edges and no square), from height $k$ upward it is the origin-allowed union $U^0$ (orange; the filled square $[0,2]^2$ and $8$ edges). (b)~The two planar slices. A source cell is contained iff its part below height $k$ projects into $U$. The figure shows a realised union, not an abstract complex}{figure.13}{}}
\newlabel{fig:slab@cref}{{[figure][13][]13}{[1][31][]31}}
