\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The evolving record (schematic; example values exact).} A reduced state $x=a/b$ determines its occurrence set $D(x)$ and fibre; the lattice $\Lambda _b$ and the region-Graver set depend on $b$ and the exponent box; the move complex $K_{\mathrm  {move}}$ is a function of $D$ alone (\cref  {thm:R3T1a}). The collective map $C$ moves the state; the occurrence set can only grow (\cref  {lem:M}); the move complex changes only through new occurrences (\cref  {sec:interval}). Example $x_0=3025/3$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:record}{{1}{4}{\textbf {The evolving record (schematic; example values exact).} A reduced state $x=a/b$ determines its occurrence set $D(x)$ and fibre; the lattice $\Lambda _b$ and the region-Graver set depend on $b$ and the exponent box; the move complex $\Kmove $ is a function of $D$ alone (\cref {thm:R3T1a}). The collective map $C$ moves the state; the occurrence set can only grow (\cref {lem:M}); the move complex changes only through new occurrences (\cref {sec:interval}). Example $x_0=3025/3$}{figure.1}{}}
\newlabel{fig:record@cref}{{[figure][1][]1}{[1][4][]4}}
