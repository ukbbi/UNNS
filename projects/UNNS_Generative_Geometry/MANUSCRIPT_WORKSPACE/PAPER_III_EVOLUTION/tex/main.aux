\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {The activation family, $k=2$ (exact; proved by \cref  {thm:A4T1,thm:A4T2}).} Parameters: $\ell =3$, $(p_1,p_2)=(5,11)$, $q=17$, $x=3025/3$, $y=935^2/3$. Left box: $x$ has a single occurrence vertex, $55$. Right box: $y$ has $D(y)=\{55,85,187\}$ and its move complex is the triangle $K_3$ with no $2$-cell, $\beta _1=1$. The relation $e_1-e_2$ is primitive but realised by no pair at $x$ (dormant) and realised by $85/187=5/11$ at $y$: activation by new occurrence vertices, not creation of a relation. The abstract objects are the Graver vectors; the geometric object is the complex.}}{27}{figure.13}\protected@file@percent }
\newlabel{fig:family}{{13}{27}{\textbf {The activation family, $k=2$ (exact; proved by \cref {thm:A4T1,thm:A4T2}).} Parameters: $\ell =3$, $(p_1,p_2)=(5,11)$, $q=17$, $x=3025/3$, $y=935^2/3$. Left box: $x$ has a single occurrence vertex, $55$. Right box: $y$ has $D(y)=\{55,85,187\}$ and its move complex is the triangle $K_3$ with no $2$-cell, $\beta _1=1$. The relation $e_1-e_2$ is primitive but realised by no pair at $x$ (dormant) and realised by $85/187=5/11$ at $y$: activation by new occurrence vertices, not creation of a relation. The abstract objects are the Graver vectors; the geometric object is the complex}{figure.13}{}}
\newlabel{fig:family@cref}{{[figure][13][]13}{[1][26][]27}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {The complete graph $K_{k+1}$ (exact; proved by \cref  {thm:A4T2}).} $k=2,3,4$: the move complex of $y$ with vertices $P,v_i=p_iq$ (abstract layout; not a geometric embedding), $\beta _1=1,3,6$. Right: $\beta _1=k(k-1)/2$ for $k=2,\dots  ,8$ is the proved formula; the values $k=2..5$ were recomputed by the engine and $k\ge 6$ are formula values (labelled as such), not computations.}}{27}{figure.14}\protected@file@percent }
\newlabel{fig:completegraph}{{14}{27}{\textbf {The complete graph $K_{k+1}$ (exact; proved by \cref {thm:A4T2}).} $k=2,3,4$: the move complex of $y$ with vertices $P,v_i=p_iq$ (abstract layout; not a geometric embedding), $\beta _1=1,3,6$. Right: $\beta _1=k(k-1)/2$ for $k=2,\dots ,8$ is the proved formula; the values $k=2..5$ were recomputed by the engine and $k\ge 6$ are formula values (labelled as such), not computations}{figure.14}{}}
