\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Rigid orbits with $G=1$ and $G=5$ (finite-exact; the pattern is proved by \cref  {thm:B2T6,thm:R3T5c}).} (a) $\log _2(x_n/x_0)$ for the integer orbit $x_0=36$ and for $x_0=126^2/5$, $n\le 12$: both advance by $2$ every three steps, so the two curves coincide (the second is drawn with hollow markers). (b) $G_n$ for both orbits and the denominator of the second: $G$ equals $1$ resp.\ $5$ throughout, which is why rigidity does not force $G_\infty =1$.}}{18}{figure.7}\protected@file@percent }
\newlabel{fig:rigid}{{7}{18}{\textbf {Rigid orbits with $G=1$ and $G=5$ (finite-exact; the pattern is proved by \cref {thm:B2T6,thm:R3T5c}).} (a) $\log _2(x_n/x_0)$ for the integer orbit $x_0=36$ and for $x_0=126^2/5$, $n\le 12$: both advance by $2$ every three steps, so the two curves coincide (the second is drawn with hollow markers). (b) $G_n$ for both orbits and the denominator of the second: $G$ equals $1$ resp.\ $5$ throughout, which is why rigidity does not force $G_\infty =1$}{figure.7}{}}
\newlabel{fig:rigid@cref}{{[figure][7][]7}{[1][17][]18}}
