\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {The void of $\{2,3,8,9,14\}$ at $m=1008$ (exact; incidence data, not a drawing of the $4$-dimensional polytope).} (a) Face counts of the permutohedral complex $K_{1008}$ and of the cubical complex $Q_{1008}$ ($f_0,\dots  ,f_3$; logarithmic scale). (b) $\mathbb  F_2$-Betti numbers: $(1,0,1,0,0)$ for $K_{1008}$ (blue, plain) and $(1,19,0,0,0)$ for $Q_{1008}$ (teal, hatched). (c) The non-admissible set $\mathcal  R$ has $24$ arrangements in two components of $\mathcal  N(\mathcal  R)$ ($12$ and $12$, the facets $E|O$ and $O|E$), whence $\beta _2=2-1=1$ by \cref  {thm:dual}. Theorems illustrated: \cref  {thm:dual}, \cref  {thm:sphere}, \cref  {ex:void}.}}{26}{figure.13}\protected@file@percent }
\newlabel{fig:void}{{13}{26}{\textbf {The void of $\{2,3,8,9,14\}$ at $m=1008$ (exact; incidence data, not a drawing of the $4$-dimensional polytope).} (a) Face counts of the permutohedral complex $K_{1008}$ and of the cubical complex $Q_{1008}$ ($f_0,\dots ,f_3$; logarithmic scale). (b) $\mathbb F_2$-Betti numbers: $(1,0,1,0,0)$ for $K_{1008}$ (blue, plain) and $(1,19,0,0,0)$ for $Q_{1008}$ (teal, hatched). (c) The non-admissible set $\mathcal R$ has $24$ arrangements in two components of $\mathcal N(\mathcal R)$ ($12$ and $12$, the facets $E|O$ and $O|E$), whence $\beta _2=2-1=1$ by \cref {thm:dual}. Theorems illustrated: \cref {thm:dual}, \cref {thm:sphere}, \cref {ex:void}}{figure.13}{}}
