\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Legal and forbidden swap diamonds (exact).} Each panel shows the states (circles) reached from a state $x$ by the labels $A$ (solid blue edges) and $B$ (dashed teal edges); dotted edges and hatched orange nodes are inadmissible. (a) $A=2$, $B=3$, $x=6$: $AB\mid x$, the diamond closes at $144$. (b) $x=2$: $A=2$ is admissible but $B=3$ is not, so only one side exists. (c) $A=2$, $B=14$, $x=14$: both labels are admissible at $14$ but $AB=28\nmid 14$, so after $2$ the label $14$ fails ($63$ is not divisible by $14$) and after $14$ the label $2$ fails. Theorem illustrated: \cref  {prop:diamond}.}}{15}{figure.7}\protected@file@percent }
\newlabel{fig:diamonds}{{7}{15}{\textbf {Legal and forbidden swap diamonds (exact).} Each panel shows the states (circles) reached from a state $x$ by the labels $A$ (solid blue edges) and $B$ (dashed teal edges); dotted edges and hatched orange nodes are inadmissible. (a) $A=2$, $B=3$, $x=6$: $AB\mid x$, the diamond closes at $144$. (b) $x=2$: $A=2$ is admissible but $B=3$ is not, so only one side exists. (c) $A=2$, $B=14$, $x=14$: both labels are admissible at $14$ but $AB=28\nmid 14$, so after $2$ the label $14$ fails ($63$ is not divisible by $14$) and after $14$ the label $2$ fails. Theorem illustrated: \cref {prop:diamond}}{figure.7}{}}
\newlabel{fig:diamonds@cref}{{[figure][7][]7}{[1][15][]15}}
