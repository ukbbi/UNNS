\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Valuation trajectories of three words of the content $\{2,3,14\}$ (exact).} The curves are $S_j(p)$ for $p=2$ (solid, circles), $3$ (dashed, squares) and $7$ (dotted, triangles); $K(w)=\DOTSB \prod@ \slimits@ _pp^{\max (0,-\min _jS_j(p))}$ is printed above each panel: $14=2\cdot 7$ for $(2,3,14)$ and $(14,3,2)$ (minima $-1$ at $p=2$ and $-1$ at $p=7$) and $21=3\cdot 7$ for $(3,14,2)$. Theorem illustrated: \cref  {thm:threshold}.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:valuation}{{5}{13}{\textbf {Valuation trajectories of three words of the content $\{2,3,14\}$ (exact).} The curves are $S_j(p)$ for $p=2$ (solid, circles), $3$ (dashed, squares) and $7$ (dotted, triangles); $K(w)=\prod _pp^{\max (0,-\min _jS_j(p))}$ is printed above each panel: $14=2\cdot 7$ for $(2,3,14)$ and $(14,3,2)$ (minima $-1$ at $p=2$ and $-1$ at $p=7$) and $21=3\cdot 7$ for $(3,14,2)$. Theorem illustrated: \cref {thm:threshold}}{figure.5}{}}
