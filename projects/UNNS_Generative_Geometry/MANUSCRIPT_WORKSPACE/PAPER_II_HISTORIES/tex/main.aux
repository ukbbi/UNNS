\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Content-level versus order-level admissibility for $\{2,3,14\}$ (exact).} Rows: the six arrangements with their thresholds $K$; columns: sources. A cell is filled and marked ``adm.'' iff $K\mid m$. The same content is wholly inadmissible at $m=7$, partly admissible at $m=14$ and $m=21$, and fully admissible among the sources shown only at $m=84=P(C)$ (\cref  {prop:sat}); it is connected for $m=28$ (\cref  {thm:2314}) although $84\nmid 28$.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:content}{{6}{13}{\textbf {Content-level versus order-level admissibility for $\{2,3,14\}$ (exact).} Rows: the six arrangements with their thresholds $K$; columns: sources. A cell is filled and marked ``adm.'' iff $K\mid m$. The same content is wholly inadmissible at $m=7$, partly admissible at $m=14$ and $m=21$, and fully admissible among the sources shown only at $m=84=P(C)$ (\cref {prop:sat}); it is connected for $m=28$ (\cref {thm:2314}) although $84\nmid 28$}{figure.6}{}}
\newlabel{fig:content@cref}{{[figure][6][]6}{[1][12][]13}}
