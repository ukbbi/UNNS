\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Counts of complete histories ending at $72^r$ (finite-exact).} Values of $H$ from the recursion \cref  {thm:predecessors}(c), computed exactly in this work and agreeing with the programme's records; the bound is \cref  {prop:growth}. These are finite computations for $r\le 6$: no growth law in $r$ is claimed (it is open, \cref  {prob:growth}).}}{10}{table.1}\protected@file@percent }
\newlabel{tab:growth}{{1}{10}{\textbf {Counts of complete histories ending at $72^r$ (finite-exact).} Values of $H$ from the recursion \cref {thm:predecessors}(c), computed exactly in this work and agreeing with the programme's records; the bound is \cref {prop:growth}. These are finite computations for $r\le 6$: no growth law in $r$ is claimed (it is open, \cref {prob:growth})}{table.1}{}}
