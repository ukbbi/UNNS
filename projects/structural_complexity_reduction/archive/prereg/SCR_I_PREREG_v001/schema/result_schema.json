{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCR-I-A Primary Result",
  "type": "object",
  "required": [
    "preregistration", "benchmark", "source_lock_pass", "pool_size", "seed",
    "n0", "n1", "r_candidate", "q_base", "q_scr", "r_eval",
    "target_count_base", "target_count_scr", "target_recall",
    "t_base_median", "t_filter_median", "t_downstream_scr_median", "t_scr_median", "g_time",
    "identity_exact_match", "verdict"
  ],
  "properties": {
    "preregistration": {"const": "SCR_I_PREREG_v001"},
    "benchmark": {"const": "SCR-I-A"},
    "source_lock_pass": {"type": "boolean"},
    "pool_size": {"enum": [2500, 10000, 40000]},
    "seed": {"type": "integer"},
    "n0": {"type": "integer", "minimum": 1},
    "n1": {"type": "integer", "minimum": 0},
    "r_candidate": {"type": "number", "minimum": 0, "maximum": 1},
    "q_base": {"type": "integer", "minimum": 0},
    "q_scr": {"type": "integer", "minimum": 0},
    "r_eval": {"type": "number"},
    "target_count_base": {"type": "integer", "minimum": 0},
    "target_count_scr": {"type": "integer", "minimum": 0},
    "target_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "t_base_median": {"type": "number", "minimum": 0},
    "t_filter_median": {"type": "number", "minimum": 0},
    "t_downstream_scr_median": {"type": "number", "minimum": 0},
    "t_scr_median": {"type": "number", "minimum": 0},
    "g_time": {"type": ["number", "null"]},
    "g_ops": {"type": ["number", "null"]},
    "identity_exact_match": {"type": "boolean"},
    "verdict": {
      "enum": [
        "SCR_CALIBRATION_SUPPORTED",
        "TARGET_LOSS",
        "NO_WORK_REDUCTION",
        "NET_SLOWDOWN",
        "INDETERMINATE_NO_TARGETS",
        "INVALID_TECHNICAL"
      ]
    }
  },
  "additionalProperties": true
}
