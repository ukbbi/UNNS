{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCR-II v001 primary result",
  "type": "object",
  "required": [
    "benchmark",
    "preregistration",
    "seed",
    "depth",
    "solution_set_sha256_baseline",
    "solution_set_sha256_scr",
    "solution_preserved",
    "nodes_baseline",
    "nodes_scr",
    "r_node",
    "seconds_baseline",
    "seconds_scr_total",
    "g_time",
    "verdict"
  ],
  "properties": {
    "benchmark": {
      "const": "ROUTE_CSP_I"
    },
    "preregistration": {
      "const": "SCR_II_PREREG_v001"
    },
    "seed": {
      "type": "integer"
    },
    "depth": {
      "enum": [
        14,
        16,
        18
      ]
    },
    "solution_set_sha256_baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solution_set_sha256_scr": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solution_preserved": {
      "type": "boolean"
    },
    "nodes_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "nodes_scr": {
      "type": "integer",
      "minimum": 1
    },
    "r_node": {
      "type": "number"
    },
    "seconds_baseline": {
      "type": "number",
      "minimum": 0
    },
    "seconds_scr_total": {
      "type": "number",
      "minimum": 0
    },
    "g_time": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "type": "string"
    }
  }
}