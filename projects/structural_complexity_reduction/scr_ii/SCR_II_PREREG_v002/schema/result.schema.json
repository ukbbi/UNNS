{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCR-II v002 result",
  "type": "object",
  "required": [
    "seed",
    "depth",
    "solution_density",
    "solution_count_baseline",
    "solution_count_scr",
    "solution_preserved",
    "r_node",
    "g_time",
    "verdict"
  ],
  "properties": {
    "seed": {
      "type": "integer"
    },
    "depth": {
      "enum": [
        14,
        16,
        18
      ]
    },
    "solution_density": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.04
    },
    "solution_count_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "solution_count_scr": {
      "type": "integer",
      "minimum": 0
    },
    "solution_preserved": {
      "type": "boolean"
    },
    "r_node": {
      "type": "number"
    },
    "g_time": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "type": "string"
    }
  }
}