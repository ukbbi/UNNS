{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROUTE_CSP_I instance",
  "type": "object",
  "required": [
    "benchmark",
    "version",
    "seed",
    "depth",
    "layers",
    "checksum_modulus",
    "checksum_target",
    "cost_min",
    "cost_max",
    "terminal_seal",
    "instance_sha256"
  ],
  "properties": {
    "benchmark": {
      "const": "ROUTE_CSP_I"
    },
    "version": {
      "const": "v001"
    },
    "seed": {
      "type": "integer"
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "layers": {
      "type": "array"
    },
    "checksum_modulus": {
      "const": 31
    },
    "checksum_target": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "cost_min": {
      "type": "integer"
    },
    "cost_max": {
      "type": "integer"
    },
    "terminal_seal": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}