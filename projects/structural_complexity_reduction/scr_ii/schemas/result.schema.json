{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCR-II primary cell result",
  "type": "object",
  "required": [
    "seed",
    "depth",
    "solution_count_baseline",
    "solution_count_scr",
    "solution_preserved",
    "nodes_baseline",
    "nodes_scr",
    "seconds_baseline",
    "seconds_scr",
    "filter_seconds",
    "verdict"
  ],
  "properties": {
    "seed": {
      "type": "integer"
    },
    "depth": {
      "type": "integer"
    },
    "solution_count_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "solution_count_scr": {
      "type": "integer",
      "minimum": 0
    },
    "solution_preserved": {
      "type": "boolean"
    },
    "nodes_baseline": {
      "type": "integer",
      "minimum": 1
    },
    "nodes_scr": {
      "type": "integer",
      "minimum": 1
    },
    "seconds_baseline": {
      "type": "number",
      "minimum": 0
    },
    "seconds_scr": {
      "type": "number",
      "minimum": 0
    },
    "filter_seconds": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "type": "string"
    }
  }
}