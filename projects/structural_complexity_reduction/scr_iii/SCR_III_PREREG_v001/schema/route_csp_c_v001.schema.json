{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempt": {
      "maximum": 63,
      "minimum": 0,
      "type": "integer"
    },
    "benchmark": {
      "const": "ROUTE_CSP_C"
    },
    "checksum_modulus": {
      "const": 5
    },
    "checksum_target": {
      "maximum": 4,
      "minimum": 0,
      "type": "integer"
    },
    "cost_max": {
      "type": "integer"
    },
    "cost_min": {
      "type": "integer"
    },
    "coupling_metadata": {
      "required": [
        "construction",
        "family_seed",
        "accepted_attempt",
        "mask_layers",
        "mask_count",
        "free_layers",
        "backbone_bits",
        "mirror_u",
        "penalty",
        "anti_coupled"
      ],
      "type": "object"
    },
    "depth": {
      "minimum": 1,
      "type": "integer"
    },
    "initial_phase": {
      "type": "integer"
    },
    "initial_symbol": {
      "type": "string"
    },
    "instance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "layers": {
      "minItems": 1,
      "type": "array"
    },
    "q": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "seed": {
      "type": "integer"
    },
    "sigma": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "terminal_seal": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "version": {
      "const": "v001"
    }
  },
  "required": [
    "benchmark",
    "version",
    "seed",
    "depth",
    "attempt",
    "sigma",
    "q",
    "initial_symbol",
    "initial_phase",
    "layers",
    "checksum_modulus",
    "checksum_target",
    "cost_min",
    "cost_max",
    "terminal_seal",
    "coupling_metadata",
    "instance_sha256"
