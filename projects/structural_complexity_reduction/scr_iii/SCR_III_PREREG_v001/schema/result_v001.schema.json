{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "benchmark": {
      "const": "ROUTE_CSP_C/v001"
    },
    "cell_verdict": {
      "type": "string"
    },
    "depth": {
      "type": "integer"
    },
    "engine": {
      "const": "SCR_III_ENGINE_v001"
    },
    "exact_preservation": {
      "type": "boolean"
    },
    "g_time": {
      "type": "number"
    },
    "instance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "population_A": {
      "type": "boolean"
    },
    "population_V": {
      "type": "boolean"
    },
    "q": {
      "type": "number"
    },
    "r_leaf": {
      "type": "number"
    },
    "r_node": {
      "type": "number"
    },
    "seed": {
      "type": "integer"
    },
    "sigma": {
      "type": "number"
    },
    "solution_count_baseline": {
      "minimum": 1,
      "type": "integer"
    },
    "solution_count_scr": {
      "minimum": 0,
      "type": "integer"
    },
    "solution_recall": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "engine",
    "benchmark",
    "seed",
    "depth",
    "sigma",
    "q",
    "instance_sha256",
    "solution_count_baseline",
    "solution_count_scr",
    "solution_recall",
    "exact_preservation",
    "r_node",
    "r_leaf",
    "g_time",
    "population_A",
    "population_V",
    "cell_verdict"
  ],
  "title": "SCR-III main cell result",
  "type": "object"
}
