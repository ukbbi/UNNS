{
  "chamber": "TEL-FINGERPRINT-I",
  "title": "Teleportation Route Identity, Closure, and Bifurcation Chamber",
  "version": "0.1.0",
  "engine_type": "standalone_browser_javascript",
  "ordering_coordinate": "lambda",
  "route_ids": ["PHI_PLUS", "PHI_MINUS", "PSI_PLUS", "PSI_MINUS"],
  "required_columns": [
    "scenario_id",
    "realization_id",
    "lambda",
    "route_id",
    "correction_status",
    "control_type",
    "noise_family",
    "noise_location",
    "branch_probability",
    "closure_defect",
    "process_fidelity",
    "choi_purity",
    "choi_entropy_norm",
    "ppt_negativity",
    "ptm_sv_1",
    "ptm_sv_2",
    "ptm_sv_3",
    "nonunital_displacement",
    "physicality_pass"
  ],
  "defect_coordinates": {
    "probability_imbalance": "abs(branch_probability - 0.25) / 0.75",
    "terminal_closure_defect": "closure_defect",
    "process_infidelity": "1 - process_fidelity",
    "choi_mixing": "1 - (choi_purity - 0.25) / 0.75",
    "choi_entropy": "choi_entropy_norm",
    "choi_entanglement_loss": "1 - 2 * ppt_negativity",
    "ptm_contraction_1": "abs(1 - ptm_sv_1)",
    "ptm_contraction_2": "abs(1 - ptm_sv_2)",
    "ptm_contraction_3": "abs(1 - ptm_sv_3)",
    "nonunital_displacement": "nonunital_displacement"
  },
  "coordinate_policy": {
    "clip_to_unit_interval": true,
    "equal_coordinate_weight": true,
    "matrix_flattening": "forbidden",
    "route_numeric_encoding": "forbidden",
    "interpolation": "forbidden",
    "lambda_sorting": "ascending_numeric",
    "duplicate_group_rows": "invalid"
  },
  "primary_distance": "root_mean_square_euclidean_on_locked_defect_coordinates",
  "default_thresholds": {
    "closed_pairwise_max": 0.05,
    "connected_edge": 0.15
  },
  "lambda_states": [
    "CLOSED",
    "DEFORMED",
    "BIFURCATED",
    "FRAGMENTED"
  ],
  "trajectory_verdicts": [
    "ROUTE_CLASS_CLOSED",
    "ROUTE_CLASS_PERSISTENT",
    "ROUTE_CLASS_BIFURCATED",
    "ROUTE_CLASS_FRAGMENTED",
    "INITIAL_CLOSURE_NOT_ESTABLISHED",
    "INSUFFICIENT_EVIDENCE"
  ],
  "controls": {
    "route_label_permutation_invariance": "mandatory",
    "deterministic_lambda_thinning": "mandatory",
    "leave_one_coordinate_out": "mandatory",
    "leave_one_realization_out_retrieval": "when_identifiable"
  },
  "scientific_boundary": "Operational structural fingerprint classification only. No direct claim about teleportation fidelity, quantum advantage, causal noise mechanism, or universal transition."
}
